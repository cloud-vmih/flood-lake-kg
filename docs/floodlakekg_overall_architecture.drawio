<mxfile host="app.diagrams.net" modified="2026-09-04T16:05:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="floodlakekg-overall" name="Overall Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Overall Architecture – Real-time Geospatial Flood Risk Platform" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="35" as="geometry" /></mxCell><mxCell id="subtitle" value="From multi-source geospatial data to actionable risk and response insights" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4F5B6B;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="1000" height="25" as="geometry" /></mxCell><mxCell id="c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D3E3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="930" as="geometry" /></mxCell><mxCell id="c1_h" value="1.  Data Sources&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;(Dynamic &amp; Static)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F9;strokeColor=#AFC6E6;fontColor=#17365D;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="70" as="geometry" /></mxCell><mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D3E3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="265" y="100" width="340" height="930" as="geometry" /></mxCell><mxCell id="c2_h" value="2.  Ingestion &amp; Orchestration&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;(Batch &amp; Streaming)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F3EA;strokeColor=#B8D8C2;fontColor=#17365D;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="265" y="100" width="340" height="70" as="geometry" /></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D3E3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="290" height="930" as="geometry" /></mxCell><mxCell id="c3_h" value="3.  Storage Layer&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;(Open Geospatial Lakehouse)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#C9BDEB;fontColor=#17365D;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="290" height="70" as="geometry" /></mxCell><mxCell id="c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D3E3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="925" y="100" width="470" height="930" as="geometry" /></mxCell><mxCell id="c4_h" value="4.  Compute &amp; Risk/Impact Processing&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;(Analytics, Modeling &amp; Query)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D7;strokeColor=#E9CB92;fontColor=#17365D;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="925" y="100" width="470" height="70" as="geometry" /></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D3E3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1410" y="100" width="250" height="930" as="geometry" /></mxCell><mxCell id="c5_h" value="5.  Serving &amp; Application&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;(Decision Support)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2FB;strokeColor=#B7D1E8;fontColor=#17365D;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1410" y="100" width="250" height="70" as="geometry" /></mxCell><mxCell id="dyn" value="&lt;b&gt;Dynamic / Near Real-time&lt;/b&gt;&lt;br&gt;&lt;br&gt;• GSMaP&lt;br&gt;• ECMWF / Open-Meteo&lt;br&gt;• ERA5-Land" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFCADF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="35" y="190" width="200" height="240" as="geometry" /></mxCell><mxCell id="static" value="&lt;b&gt;Static / Reference&lt;/b&gt;&lt;br&gt;&lt;br&gt;• DEM&lt;br&gt;• SoilGrids&lt;br&gt;• HydroBASINS / BasinATLAS&lt;br&gt;• OSM&lt;br&gt;• WorldPop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFF;strokeColor=#8CBED8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="35" y="455" width="200" height="330" as="geometry" /></mxCell><mxCell id="airflow" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Schedule batch retrieval&lt;br&gt;• Orchestrate batch jobs&lt;br&gt;• Manage dependencies &amp; retries&lt;br&gt;• Trigger backfill/replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FCF8;strokeColor=#8FC6A0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="285" y="190" width="300" height="160" as="geometry" /></mxCell><mxCell id="batch" value="&lt;b&gt;Batch Ingestion / Preprocessing&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Python + GeoPandas + Rasterio&lt;/b&gt;&lt;br&gt;• Static data preprocessing&lt;br&gt;• CRS / schema harmonization&lt;br&gt;• Initial spatial feature preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FCF8;strokeColor=#8FC6A0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="285" y="375" width="300" height="180" as="geometry" /></mxCell><mxCell id="kafka" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Source events&lt;br&gt;• Buffering / decoupling&lt;br&gt;• Change / impact event topics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F8;strokeColor=#E4A0A0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="285" y="580" width="140" height="150" as="geometry" /></mxCell><mxCell id="flink" value="&lt;b&gt;Apache Flink&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Validate &amp; deduplicate&lt;br&gt;• Handle late / out-of-order data&lt;br&gt;• Map dynamic data to sub-basin&lt;br&gt;• Detect changes &amp; emit events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F8;strokeColor=#E4A0A0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="445" y="580" width="140" height="200" as="geometry" /></mxCell><mxCell id="monitor" value="&lt;b&gt;Monitoring &amp; Alerting&lt;/b&gt;&lt;br&gt;Pipeline status • data quality • failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#D4DCE8;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="285" y="815" width="300" height="70" as="geometry" /></mxCell><mxCell id="minio" value="&lt;b&gt;MinIO&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6573'&gt;(Object Storage)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Raw/source files&lt;br&gt;• GeoTIFF, NetCDF, Parquet, GeoParquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF9FF;strokeColor=#B8A2DF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="250" height="150" as="geometry" /></mxCell><mxCell id="iceberg" value="&lt;b&gt;Apache Iceberg Tables&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Open table format&lt;br&gt;• Snapshots &amp; time travel&lt;br&gt;• Versioned geospatial tables&lt;br&gt;• State &amp; change events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF9FF;strokeColor=#B8A2DF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="640" y="370" width="250" height="240" as="geometry" /></mxCell><mxCell id="org" value="&lt;b&gt;Data Organization&lt;/b&gt;&lt;br&gt;&lt;br&gt;reference_static&lt;br&gt;observation_forecast&lt;br&gt;subbasin_features&lt;br&gt;subbasin_risk_state&lt;br&gt;impact_results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#D4DCE8;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="655" y="635" width="220" height="210" as="geometry" /></mxCell><mxCell id="catalog" value="&lt;b&gt;3b. Catalog &amp; Metadata&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Iceberg REST Catalog&lt;/b&gt;&lt;br&gt;• Table &amp; schema metadata&lt;br&gt;• Partition metadata&lt;br&gt;• Engine integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FD;strokeColor=#B79DDF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="640" y="875" width="250" height="120" as="geometry" /></mxCell><mxCell id="spark" value="&lt;b&gt;Apache Spark + Sedona&lt;/b&gt;&lt;br&gt;&lt;font color='#6A5A27'&gt;Batch / heavy compute&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Build geospatial basin features&lt;br&gt;• FFG-inspired threat computation&lt;br&gt;• Historical backfill &amp; replay&lt;br&gt;• Full recomputation benchmark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D8B86B;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="945" y="190" width="430" height="170" as="geometry" /></mxCell><mxCell id="trino" value="&lt;b&gt;Trino&lt;/b&gt;&lt;br&gt;&lt;font color='#6A5A27'&gt;Query &amp; analytics&lt;/font&gt;&lt;br&gt;&lt;br&gt;• SQL query on Iceberg tables&lt;br&gt;• Cross-source analytical queries&lt;br&gt;• Ad-hoc analysis / reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D8B86B;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="945" y="380" width="430" height="125" as="geometry" /></mxCell><mxCell id="postgis" value="&lt;b&gt;PostGIS&lt;/b&gt;&lt;br&gt;&lt;font color='#6A5A27'&gt;Spatial &amp; direct impact processing&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Spatial joins / intersects&lt;br&gt;• Map hazard to communes / roads / facilities&lt;br&gt;• Compute direct exposure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D8B86B;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="945" y="525" width="430" height="145" as="geometry" /></mxCell><mxCell id="neo4j" value="&lt;b&gt;Neo4j&lt;/b&gt;&lt;br&gt;&lt;font color='#6A5A27'&gt;Incremental Knowledge Graph&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Update MAY_AFFECT / MAY_BLOCK / MAY_ISOLATE&lt;br&gt;• Dependency relationships&lt;br&gt;• Cascading impact reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D8B86B;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="945" y="690" width="430" height="145" as="geometry" /></mxCell><mxCell id="routing" value="&lt;b&gt;pgRouting / NetworkX&lt;/b&gt;&lt;br&gt;&lt;font color='#6A5A27'&gt;Risk-aware routing&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Propagate road/network impacts&lt;br&gt;• Compute lower-risk response routes&lt;br&gt;• Identify isolated areas / alternatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D8B86B;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="945" y="855" width="430" height="140" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;&lt;br&gt;• REST APIs&lt;br&gt;• Risk / impact / route endpoints&lt;br&gt;• Query operational stores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFF;strokeColor=#8CBED8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="190" width="210" height="150" as="geometry" /></mxCell><mxCell id="dash" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6573'&gt;Streamlit / MapLibre&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Interactive risk map&lt;br&gt;• Affected assets / communes&lt;br&gt;• Recommended routes&lt;br&gt;• Time / scenario filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFF;strokeColor=#8CBED8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="390" width="210" height="210" as="geometry" /></mxCell><mxCell id="users" value="&lt;b&gt;End Users&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Authorities&lt;br&gt;• Emergency responders&lt;br&gt;• Communities / researchers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFF;strokeColor=#8CBED8;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="675" width="210" height="150" as="geometry" /></mxCell><mxCell id="e_dyn_kafka" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#255F99;strokeWidth=1.7;endArrow=block;endFill=1;" edge="1" parent="1" source="dyn" target="kafka"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dyn_airflow" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#255F99;strokeWidth=1.7;endArrow=block;endFill=1;" edge="1" parent="1" source="dyn" target="airflow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_static_batch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#255F99;strokeWidth=1.7;endArrow=block;endFill=1;" edge="1" parent="1" source="static" target="batch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_airflow_batch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#255F99;strokeWidth=1.7;endArrow=block;endFill=1;" edge="1" parent="1" source="airflow" target="batch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_kafka_flink" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySi